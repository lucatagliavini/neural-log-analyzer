.venv/
__pycache__/
profiles/*/models/*.backup/
profiles/*/models/*.backup2/
tmp/
# Log di utilizzo e performance (chatbot-YYYY-MM-DD.log): dati di runtime,
# specifici dell'installazione. Anche escluso da deploy.sh, così i log
# accumulati in produzione non vengono sovrascritti dai deploy.
logs/
# Contiene host e path dell'ambiente di produzione: resta locale per scelta.
deploy.sh
# Configurazione locale di Claude Code: ambiente di sviluppo, non del prodotto.
# Anche escluso da deploy.sh (entrambi i rsync), così non finisce in produzione.
.claude/
